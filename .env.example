# ── Core ───────────────────────────────────────────────
APP_URL=http://localhost:3210
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/renderai
# In production behind Caddy/Render, the web server listens on $PORT.
PORT=3000
# Public hostname used by Caddy for automatic HTTPS (VPS deploy).
DOMAIN=app.renderai.com

# ── Better Auth ────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3210

# ── Google OAuth (isi untuk mengaktifkan login Google) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── JWT (token sekali pakai / sementara) ───────────────
JWT_SECRET=
JWT_ISSUER=renderai
JWT_AUDIENCE=renderai-app

# ── Rate limiter ───────────────────────────────────────
RATE_LIMIT_DRIVER=database
RATE_LIMIT_ENABLED=true

# ── Session durations (detik) ──────────────────────────
SESSION_DEFAULT_MAX_AGE=604800
SESSION_REMEMBER_ME_MAX_AGE=2592000
ADMIN_SESSION_MAX_AGE=43200
SENSITIVE_ACTION_MAX_AGE=900

# ── Storage: Cloudflare R2 ─────────────────────────────
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Email: Resend ──────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=RenderAI <onboarding@resend.dev>

# ── Payment ────────────────────────────────────────────
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_WEBHOOK_SECRET=
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_MERCHANT_ID=
DOKU_ENV=sandbox

# ── AI provider ────────────────────────────────────────
AI_PROVIDER=fal
MYARCHITECTAI_API_KEY=
SELFHOST_SD_API_URL=
SELFHOST_SD_API_KEY=
SELFHOST_SD_TIMEOUT_SECONDS=300
FAL_KEY=
FAL_RENDER_MODEL=fal-ai/flux-kontext/dev
FAL_STYLE_TRANSFER_MODEL=fal-ai/uso
FAL_UPSCALE_MODEL=fal-ai/aura-sr
FAL_START_TIMEOUT_SECONDS=300

# ── Upload ─────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ── Worker / queue ─────────────────────────────────────
# inline = web route langsung memproses job setelah enqueue (praktis untuk dev).
# worker = web hanya enqueue; proses render wajib dijalankan oleh pnpm worker.
# Production wajib pakai worker.
RENDER_PROCESSING_MODE=inline

# Concurrency today = number of worker containers (each processes 1 job per
# tick, pulled with SKIP LOCKED). The values below are reserved for the roadmap
# (in-process concurrency / per-user guardrails — not yet wired in code).
WORKER_ENABLED=true
WORKER_REPLICAS=2
WORKER_CONCURRENCY=4
TOTAL_RENDER_CONCURRENCY=8
JOB_POLL_INTERVAL_SECONDS=5
JOB_LOCK_TIMEOUT_SECONDS=300
MAX_RENDER_ATTEMPTS=3
MAX_PROCESSING_RENDER_PER_USER=1
MAX_QUEUED_RENDER_PER_USER=3

# ── Feature flags (reserved for roadmap — not yet wired) ─
FEATURE_DOKU_ENABLED=false
FEATURE_STYLE_TRANSFER_ENABLED=true
FEATURE_UPSCALE_ENABLED=true
FEATURE_ADMIN_CREDIT_ADJUSTMENT=true
FEATURE_EMAIL_RENDER_SUCCESS=false
