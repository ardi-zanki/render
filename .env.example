# Local development template: copy to .env.local, then fill the two secrets.
# For production, follow DEPLOYMENT.md before copying these local defaults.
# Next loads .env.local; CLI scripts preserve values already set in process env.
# Booleans accept true/false (blank uses the schema default).
# Durations are positive integer seconds.

# ── Core ───────────────────────────────────────────────
APP_URL=http://localhost:3210
NODE_ENV=development
DATABASE_URL=postgresql://renderai:renderai@localhost:5433/renderai
# In production behind Caddy/Render, the web server listens on $PORT.
PORT=3000
# Public hostname used by Caddy for automatic HTTPS (VPS deploy).
DOMAIN=app.example.com

# ── Better Auth ────────────────────────────────────────
# Generate each secret separately with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3210

# ── Google OAuth (optional; set both values to enable) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── JWT (temporary / one-time tokens) ──────────────────
JWT_SECRET=
JWT_ISSUER=renderai
JWT_AUDIENCE=renderai-app

# ── Rate limiter ───────────────────────────────────────
RATE_LIMIT_DRIVER=database
RATE_LIMIT_ENABLED=true

# ── Session durations (seconds) ────────────────────────
# Without Remember me, the browser session cookie ends when the browser closes.
SESSION_REMEMBER_ME_MAX_AGE=2592000
ADMIN_SESSION_MAX_AGE=43200
SENSITIVE_ACTION_MAX_AGE=900

# ── Storage: local for development, r2 for production ──
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Deprecated, only needed temporarily to migrate legacy avatar URLs. Keep the
# R2 bucket private and leave this blank for new deployments.
R2_PUBLIC_URL=
# Origins allowed to read R2 assets cross-origin (comma-separated). Used by
# `pnpm cors:setup`. Leave blank to fall back to APP_URL.
R2_CORS_ORIGINS=

# ── Email: Resend ──────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Without a key, email links are logged only in development/test.
# Production requires a Resend key and an approved sender.
EMAIL_FROM=RenderAI <onboarding@resend.dev>

# ── Support ────────────────────────────────────────────
SUPPORT_EMAIL=support@renderai.id
# Optional channels are hidden until a real production URL is configured.
SUPPORT_WHATSAPP_URL=
SUPPORT_WHATSAPP_LABEL=
SUPPORT_INSTAGRAM_URL=
SUPPORT_INSTAGRAM_LABEL=

# ── Payment ────────────────────────────────────────────
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── AI provider ────────────────────────────────────────
# Use fal + private R2 storage for real renders. mock needs no API key.
AI_PROVIDER=mock
FAL_KEY=
# Optional alternative to FAL_KEY when credentials are stored separately.
FAL_KEY_ID=
FAL_KEY_SECRET=
FAL_RENDER_MODEL=fal-ai/flux-2-pro/edit
FAL_STYLE_TRANSFER_MODEL=fal-ai/uso
FAL_UPSCALE_MODEL=fal-ai/aura-sr
FAL_INPAINT_MODEL=fal-ai/flux-pro/v1/fill
FAL_START_TIMEOUT_SECONDS=300
# FLUX.2 [pro] edit tuning (see src/lib/providers/ai/fal.ts)
FAL_RENDER_MAX_EDGE=2048
FAL_RENDER_SAFETY_TOLERANCE=2
# FAL_RENDER_SEED=42   # set for reproducible renders, leave unset for variety

# ── Worker / queue ─────────────────────────────────────
# inline = web processes jobs in the request path (local development).
# worker = web enqueues; start pnpm worker with the same database/providers.
# Unset defaults to inline locally, worker in production. Multi-instance
# production requires worker; explicit inline is for a single low-volume web.
RENDER_PROCESSING_MODE=inline
JOB_LOCK_TIMEOUT_SECONDS=300

# ── Development tooling (optional) ─────────────────────
# PLAYWRIGHT_PORT=3211  # use another port when pnpm dev is already running
# NEXT_DIST_DIR=.next  # Playwright uses .next-e2e automatically

# Upload limits are defined in src/lib/uploads/image-constraints.ts.
# Worker throughput is controlled by replicas, not WORKER_CONCURRENCY env vars.
# Each worker processes one job at a time and polls every 2s when idle.
