{
  "name": "renderai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "env RENDER_PROCESSING_MODE=worker next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "check:design-system": "node scripts/check-design-system.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "smoke:auth": "tsx --env-file-if-exists=.env.local scripts/smoke-auth.ts",
    "smoke:render": "tsx --env-file-if-exists=.env.local scripts/smoke-render.ts",
    "smoke:payment": "tsx --env-file-if-exists=.env.local scripts/smoke-payment.ts",
    "render:worker": "tsx --env-file-if-exists=.env.local scripts/render-worker.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/render-worker.ts",
    "make:admin": "tsx --env-file-if-exists=.env.local scripts/make-admin.ts",
    "cors:setup": "tsx --env-file-if-exists=.env.local scripts/setup-r2-cors.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@fal-ai/client": "^1.10.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.4",
    "@img/sharp-linux-x64": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
