{
  "name": "renderai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "env RENDER_PROCESSING_MODE=worker next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "check:design-system": "node scripts/check-design-system.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "smoke:auth": "tsx --env-file=.env.local scripts/smoke-auth.ts",
    "smoke:render": "tsx --env-file=.env.local scripts/smoke-render.ts",
    "smoke:payment": "tsx --env-file=.env.local scripts/smoke-payment.ts",
    "render:worker": "tsx --env-file=.env.local scripts/render-worker.ts",
    "worker": "tsx scripts/render-worker.ts",
    "make:admin": "tsx --env-file=.env.local scripts/make-admin.ts",
    "cors:setup": "tsx --env-file=.env.local scripts/setup-r2-cors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@fal-ai/client": "^1.10.1",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "sharp": "0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
